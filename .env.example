# Copy to .env and fill in. Never commit .env.

# ----------------------------------------------------------------------------
# Stream keys
# ----------------------------------------------------------------------------

# The ONE key your phone/encoder uses to publish - same key works for SRTLA,
# SRT and RTMP (see the "Connect your encoder" card in the dashboard for the
# exact URLs once it's running). Generate with: openssl rand -hex 16
PUBLISH_KEY=change-me

# Internal playback id OBS uses to read the ingested stream. Never exposed
# outside the compose network (port 4000 isn't published) - the default is
# fine, only change it if you need to (e.g. running more than one stack on
# the same sls state volume, which isn't a supported setup here).
PLAY_KEY=live

# Internal secret OBS uses to push into the ingest container's restream app,
# which then fans out to every Twitch channel you add in the dashboard.
# Never seen by a real encoder/viewer. Generate with: openssl rand -hex 16
RESTREAM_KEY=change-me

# ----------------------------------------------------------------------------
# obs-websocket password (shared by obs, watchdog, dashboard).
# Generate with: openssl rand -hex 16
OBS_WS_PASSWORD=change-me

# Dashboard login (Caddy forward_auth against the dashboard's own session).
# Generate the hash with (the plain `docker run`, NOT `docker compose run` -
# the latter also starts every service caddy depends_on, cascading into the
# full OBS build/start as a side effect of just wanting a password hash):
#   printf '%s\n' 'YOUR_PASSWORD' | docker run --rm -i caddy \
#       caddy hash-password --algorithm bcrypt
#
# Fed over stdin rather than with --plaintext: command arguments are readable
# by any local account through /proc/<pid>/cmdline. --algorithm is explicit
# because the dashboard verifies with bcrypt, and caddy's own help recommends
# argon2id.
#
# IMPORTANT: escape every literal $ in the hash as $$ here - docker compose
# interpolates .env values, and a bare $ (bcrypt hashes are full of them,
# e.g. $2a$14$...) gets silently swallowed as a reference to an undefined
# variable, corrupting the hash.
#
# Do NOT check this with `docker compose config`: it re-escapes $ in its own
# output so the output stays reusable, so a correct 60-character hash appears
# there as 63 and looks broken. Ask the container what it actually got:
#   docker compose exec dashboard sh -c 'printf "%s" "$DASH_PASS_HASH" | wc -c'
# Expect exactly 60.
DASH_USER=admin
DASH_PASS_HASH=change-me

# ----------------------------------------------------------------------------
# The address your streamers/viewers use to reach this server. Used twice:
# it's the host shown in the dashboard's connection-info card, AND it's the
# site address caddy/Caddyfile serves the panel on (so it decides which
# hostname Let's Encrypt issues the certificate for).
#
# REQUIRED - Caddy will not start on an empty site address. Running without
# a domain (plain IP, self-signed) needs the manual Caddyfile edit described
# in the comment at the top of caddy/Caddyfile.
#
# IMPORTANT if you put Cloudflare (or any UDP-blind proxy) in front of this
# domain: keep DNS-only (grey cloud) for it. SRT and SRTLA are UDP; an
# orange-cloud proxy simply drops the connection.
DOMAIN=stream.example.com

# Optional: srtla_rec log verbosity: error, warn, info, debug
#SRTLA_LOG_LEVEL=info
