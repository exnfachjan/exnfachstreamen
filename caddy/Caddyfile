# Internal auth gate behind the Cloudflare tunnel - plain HTTP, no TLS.
#
# Cloudflare terminates TLS for the panel hostname and cloudflared (its own
# container in docker-compose.yml) forwards every request here as
# http://caddy:80. No port of this container is published on the host, so the
# only way to reach it is through the tunnel.
#
# Authentication is a session cookie issued by the dashboard's own login page;
# Caddy asks the dashboard to validate it (forward_auth) on every protected
# request, so the remote OBS (noVNC) is covered by the same login.

{
	# No certificates to manage: the site below is http:// only, and this
	# stops Caddy from trying to redirect anything to an HTTPS it doesn't serve.
	auto_https off
}

:80 {
	# Public: the login page and the login endpoint themselves.
	@public path /login /api/login
	handle @public {
		reverse_proxy dashboard:8000
	}

	# Remote OBS via noVNC:  /obs/vnc.html?path=obs/websockify&autoconnect=true
	handle_path /obs/* {
		forward_auth dashboard:8000 {
			uri /auth/verify
		}
		reverse_proxy obs:6080
	}

	handle {
		forward_auth dashboard:8000 {
			uri /auth/verify
		}
		reverse_proxy dashboard:8000
	}
}
